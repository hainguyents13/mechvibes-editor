# The Mechvibes website the editor links to and calls (sign-in, My packs,
# Update). Read at build time; defaults to https://mechvibes.com when unset.
# For local work against the website's dev server: http://localhost:3000
VITE_WEBSITE_URL=

# Google Analytics 4 measurement ID, shared with the website. Leave empty for
# local work so it stays out of the reports; the Docker image sets it.
VITE_GA_MEASUREMENT_ID=
